              "characterId": "",
              "characterName": "悠宝",
              "expression": "正面站立",
              "text": "（在LetsGal里改过的对白）ssasa'asa'a'asa'a'a'asa'a'a'a'asa'a'a'a'a'a"
            },
            {
              "id": "9fc09269a20f44fe88e6a09194454070",
              "kind": "dialogue",
              "characterId": "d0be95304a2b41aaac6c168cb608dd25",
              "characterName": "沐雪",
              "expression": "默认",
              "text": "今天天气真不错呢。"
            },
            {
              "id": "76c8cbe68e82489a9cf65a165568da4b",
              "kind": "dialogue",
              "characterId": "",
              "characterName": "沐雪",
              "expression": "调皮坏笑",
              "text": "我们出去玩吧！"
            },
            {
              "id": "420e39d7badd44edb67b1e9aeaed3666",
              "kind": "dialogue",
              "characterId": "3e728c8783b14ef9bb5ae14c0e41df82",
              "characterName": "沐星",
              "expression": "灿烂微笑",
              "text": "好呀好呀，走吧！"
            },
            {
              "id": "094d57a700be4c038f2319c611bed05d",
              "kind": "dialogue",
              "characterId": "227316a5395e4fd5aea175a1db18ea14",
              "characterName": "悠宝",
              "expression": "含蓄合拢",
              "text": "那……一起出发吧。"
            },
            {
              "id": "4da4bae3788e499f9d5a688f3f3cb82a",
              "kind": "scene",
              "sceneId": "18252437dc0d4f16afc1c18620ed36b9",
              "sceneName": "客厅（夜晚）"
            },
            {
              "id": "259481dec16440baa9dc91f026c8b85e",
              "kind": "narration",
              "text": "夜幕降临，三人回到了·家."
            },
            {
              "id": "a715bb63aa4a40458270b503b23aaeba",
              "kind": "dialogue",
              "characterId": "",
              "characterName": "沐雪",
              "expression": "脸红慌张",
              "text": "今天玩得……真开心。"
            },
            {
              "id": "105db99d47344b99b5da2b9ad41a9e39",
              "kind": "dialogue",
              "characterId": "",
              "characterName": "悠宝",
              "expression": "正面站立",
              "text": "好吧就是这样"
            },
            {
              "id": "fd879b0a64844e18a25d58376112f377",
